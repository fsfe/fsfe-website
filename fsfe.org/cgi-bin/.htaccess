<IfModule mod_rewrite.c>
RewriteEngine On

# --- AI crawlers ---
RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Meta-ExternalAgent|Amazonbot|cohere-ai|AI2Bot|Diffbot|ImagesiftBot) [NC]
RewriteRule .* - [F,L]

# --- Headless browsers and scripting clients ---
RewriteCond %{HTTP_USER_AGENT} (HeadlessChrome|PhantomJS|SlimerJS|puppeteer|playwright|selenium|electron) [NC]
RewriteRule .* - [F,L]
</IfModule>
