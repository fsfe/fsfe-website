<?xml version="1.0" encoding="utf-8"?>
<data>
  <version>3</version>

  <module>
    <div class="banner-subscribe">
      <p>
        Iscriviti ai nostri aggiornamenti per email. I nostri esperti ti
        informeranno sulle notizie più recenti, gli eventi, le attività e su come partecipare <span class="privacy-note">(la nostra <a href="/about/legal/imprint.html#id-privacy-policy">Privacy Policy</a>)</span>.
      </p>

      <form class="form-inline" method="post" action="https://my.fsfe.org/subscribe" aria-label="Modulo di iscrizione alla newsletter">
        <input type="hidden" name="language" value="it"/>
        <input type="input" class="visually-hidden" name="password" tabindex="-1" autocomplete="off"/>
        <div class="form-group">
		  <label for="subscribe-name" class="sr-only">Il tuo nome</label>
          <input type="text" class="form-control" id="subscribe-name" name="name" placeholder="Il tuo nome" required="required"/>
        </div>
        <div class="form-group">
		  <label for="subscribe-email" class="sr-only">Il tuo indirizzo email</label>
          <input type="email" class="form-control" id="subscribe-email" name="email1" placeholder="Il tuo indirizzo email" required="required"/>
        </div>
        <fsfe-cd-referrer-input/>
        <input type="hidden" name="wants_info" value="yes"/>
        <input type="hidden" name="wants_newsletter_info" value="yes"/>
        <input type="hidden" name="category" value="i"/>
        <button class="btn btn-default" type="submit">Voglio rimanere informato</button>
      </form>
    </div>
  </module>
</data>
